# Copy to .env and fill in. See README.md for how to get each value.

OPENEMR_BASE_URL=https://localhost:9300
# OPENEMR_FHIR_BASE_URL and OPENEMR_OAUTH_TOKEN_URL default from OPENEMR_BASE_URL;
# override only if your FHIR/OAuth paths differ.

# From `openemr-cmd worktree exec ... e` (or docker compose exec openemr) after
# registering + enabling a client -- see README.md "Local setup".
OPENEMR_OAUTH_CLIENT_ID=
OPENEMR_OAUTH_CLIENT_SECRET=

# Optional -- overrides app/config.py's default scope string. Leave unset to
# use the default, which already includes the six document-ingestion
# scopes: user/document.s (list), user/document.c (create), user/document.r
# (read one back -- currently blocked by a separate CSRF bug, README.md's
# "Known gap"), user/DocumentReference.s (FHIR search, not .read),
# user/Binary.read (FHIR file fetch for the click-to-source preview --
# note the .read suffix, not .r: the server only defines Binary under
# FHIR's older V1 naming convention), and user/patient.r (Standard API
# single-patient read, powers resolve_internal_pid() -- see app/config.py's
# own comment for why this replaced an earlier encounter-based approach
# that broke for any patient with no encounter on file) -- see app/
# config.py's own comment for exactly how each was confirmed (a clean live
# test against this deployment, not log inference). The registered
# client's own `scope` column (oauth_clients table) did NOT gate
# user/DocumentReference.s in testing, but DID silently drop
# user/Binary.read/.r and user/patient.r until a one-row UPDATE registered
# each there too (README.md) -- the earlier "did NOT gate" finding does
# not generalize to every scope; confirm per-scope via a decoded token's
# own `scopes` claim, don't assume. Also needs the files_white_list DB fix
# (README.md, same section) before any upload will succeed -- a separate,
# unrelated requirement, not a scope issue.
OPENEMR_OAUTH_SCOPE=

# Password-grant credential -- eval suite only (evals/run_evals.py), which has
# no browser to complete an interactive login. Never used by the live /chat
# or /ui path: those use a real per-resident authorization_code login instead
# (see README.md "Local setup" step 1, app/oauth_session.py).
OPENEMR_OAUTH_USERNAME=admin
OPENEMR_OAUTH_PASSWORD=pass

# Only for a self-signed local dev cert (docker/development-easy). Never set
# to false against a real deployment.
OPENEMR_VERIFY_TLS=false

# Per-attempt timeout (seconds) for every FHIR/OAuth call, applied once on
# the shared httpx.Client (app/config.py's Settings.request_timeout_seconds
# docstring). A timed-out or 5xx first attempt gets exactly one retry at
# half this value, never a fresh full timeout -- see app/fhir_client.py's
# FhirClient._get_with_retry.
REQUEST_TIMEOUT_SECONDS=12

# Where this app itself is reachable -- must match a redirect_uri registered
# on the OAuth client above (README.md "Local setup" step 1).
COPILOT_BASE_URL=http://localhost:8420

# Optional. A dedicated low-privilege demo account (see README.md "Local
# setup" step 2) used only by evals/cases.py's oauth_scope_enforcement_denied
# case and for manual scope-restriction verification -- never a real
# resident's credential. That eval case skips (not fails) if left unset.
OPENEMR_SCOPE_TEST_USERNAME=
OPENEMR_SCOPE_TEST_PASSWORD=

ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5

# Leave blank to disable Langfuse (the app still logs locally). See
# docker/docker-compose.langfuse.yml to run Langfuse locally.
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=http://localhost:3300

# --- Logging and exposure (see W2_ARCHITECTURE.md 4.20) ---
# Salt for the identifier hashes that replace patient_id / resident_username in every log line, so a patient can be
# followed across log lines without being identifiable. Set a long random value in production (for example
# `openssl rand -hex 32`); if unset, a random per-process salt is used and tokens change on every restart.
LOG_HASH_SALT=
# Serve the interactive API docs (/docs, /redoc, /openapi.json). Leave unset in production; for local development only.
ENABLE_API_DOCS=
